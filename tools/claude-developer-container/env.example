# Copy to .env next to docker-compose.yml and adjust.

# Absolute path of the klabis checkout on this host (mounted at the same path in the container)
KLABIS_DIR=/home/user/klabis

GIT_AUTHOR_NAME=David Polach
GIT_AUTHOR_EMAIL=d.polach@dpolach.com

# Optional toolsets baked into the image (rebuild after a change: docker compose up -d --build)
# WITH_JAVA: JDK 21 for the backend (Gradle comes from the wrapper)
# WITH_E2E:  Playwright browsers + Playwright MCP plugin; requires WITH_JAVA=true
WITH_JAVA=true
WITH_E2E=true

# GitLab token (read_api) for the gitlab-zbm Maven repository used by backend/build.gradle.kts (WITH_JAVA only)
GITLAB_ZBM_TOKEN=

# Session name shown in claude.ai/code
RC_SESSION_NAME=klabis

# CPUS=3 keeps the backend test suite at a single fork (availableProcessors / 4), which fits into 4 GB
MEM_LIMIT=4g
MEMSWAP_LIMIT=6g
CPUS=3
