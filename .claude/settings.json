{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "SDLC_REPO": "zabiny/klabis"
  },
  "permissions": {
    "allow": [
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_wait_for",
      "mcp__plugin_playwright_playwright__browser_network_requests",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__get_network_request",
      "mcp__jetbrains__get_file_text_by_path",
      "Bash(lsof:*)",
      "Bash(openspec status:*)",
      "Bash(openspec validate:*)",
      "Bash(openspec instructions:*)",
      "Bash(openspec list:*)",
      "Bash(./runLocalEnvironment.sh)",
      "Bash(./runLocalEnvironment.sh:*)"
    ],
    "deny": [
      "Bash(gh:*)",
      "Bash(git push:*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__create_branch",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__update_pull_request_branch",
      "mcp__github__pull_request_review_write",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__add_issue_comment",
      "mcp__github__issue_write",
      "mcp__github__create_repository",
      "mcp__github__fork_repository"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; if echo \"$f\" | grep -qE 'frontend/.*\\.(ts|tsx|js|jsx)$'; then cd frontend && npx eslint --fix \"$f\" 2>/dev/null; fi; } || true",
            "statusMessage": "Running ESLint fix..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sleep 1",
            "statusMessage": "Letting language server catch up to prevent stale diagnostics"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/sdlc-openspec.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agentic-sdlc@agentic-sdlc": true
  },
  "sandbox": {
    "excludedCommands": [
      "./runLocalEnvironment.sh",
      "./gradlew *",
      "/home/davca/bin/gradle *",
      "/usr/bin/ps *",
      "/usr/bin/lsof *"
    ],
    "network": {
      "allowedDomains": [
        "repo.maven.apache.org",
        "repo1.maven.org",
        "plugins.gradle.org",
        "downloads.gradle.org",
        "services.gradle.org",
        "repo.spring.io",
        "gitlab.polach.cloud",
        "registry.npmjs.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/home/davca/.gradle",
        "/mnt/ramdisk/klabis"
      ],
      "allowRead": [
        "/home/davca/.gradle",
        "/mnt/ramdisk/klabis"
      ]
    }
  },
  "extraKnownMarketplaces": {
    "agentic-sdlc": {
      "source": {
        "source": "github",
        "repo": "dapolach/agentic-sdlc"
      }
    }
  }
}
